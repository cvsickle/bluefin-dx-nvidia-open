{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)build_files/build\\.sh$"],
      "matchStrings": [
        "catppuccin_version=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"[\\s\\S]*?catppuccin_sha256=\"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "custom.catppuccin-release-assets",
      "depNameTemplate": "Fausto-Korpsvart/Catppuccin-GTK-Theme",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)build_files/build\\.sh$"],
      "matchStrings": [
        "font_version=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"[\\s\\S]*?font_sha256=\"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "custom.nerd-fonts-release-assets",
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "versioningTemplate": "semver-coerced"
    }
  ],

  "customDatasources": {
    "catppuccin-release-assets": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/Fausto-Korpsvart/Catppuccin-GTK-Theme/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($, function($release) { {\"version\": $release.tag_name, \"digest\": $substringAfter($release.assets[name = 'Catppuccin.tar.xz'][0].digest, 'sha256:')} })}"
      ]
    },
    "nerd-fonts-release-assets": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/ryanoasis/nerd-fonts/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($, function($release) { {\"version\": $release.tag_name, \"digest\": $substringAfter($release.assets[name = 'JetBrainsMono.tar.xz'][0].digest, 'sha256:')} })}"
      ]
    }
  },

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
